# Python bytecode caches
__pycache__/
*.py[cod]

# macOS
.DS_Store

# sound/music/world-map-overview assets are generated at runtime (audio) or
# by a dev-only script (world_map.png) if missing — not worth tracking. The
# hand-drawn pixel art (*.png) has no such fallback and IS tracked, so a
# fresh checkout/build actually has it.
assets/*
!assets/*.png
assets/world_map.png

# player save files — runtime data, not source
saves/
